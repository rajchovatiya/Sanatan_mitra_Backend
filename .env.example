APP_NAME="Sanatan Mitra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanatan_mitra
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Login OTP: "log" writes the code to storage/logs/laravel.log (development only)
OTP_DRIVER=log
OTP_EXPOSE_CODE=false
# Client testing only (e.g. OTP_TEST_CODE=1234 with OTP_LENGTH=4). Empty before launch.
OTP_LENGTH=6
OTP_TEST_CODE=

# Panchang/Kundli provider: "none" until the provider details are added
ASTROLOGY_DRIVER=none

# Push notifications: "log" until Firebase is set up, then "fcm" and the service-account file path
PUSH_DRIVER=log
# FIREBASE_CREDENTIALS=/full/path/outside/public/firebase.json

# "Translate" button in admin forms: "none" until a service is chosen, then "google" with its API key
TRANSLATE_DRIVER=none
# GOOGLE_TRANSLATE_KEY=
